Players.PlayerAdded:Connect(function(p)
    local pg = p:WaitForChild("PlayerGui")
    for _, c in ipairs(StarterGui:GetChildren()) do
        if not pg:FindFirstChild(c.Name) then
            c:Clone().Parent = pg
        end
    end
end)

