-- 2. Build ReplicatedStorage Hierarchy & Remotes
local function buildNode(nodeData, parent)
    if nodeData.isScriptRef then return end
    local inst = parent:FindFirstChild(nodeData.name)
    if not inst then
        local success, newInst = pcall(function() return Instance.new(nodeData.className) end)
        if success and newInst then
            inst = newInst
            inst.Name = nodeData.name
            for pk, pv in pairs(nodeData.properties or {}) do
                pcall(function() inst[pk] = deserializeValue(pv) end)
            end
            for ak, av in pairs(nodeData.attributes or {}) do
                pcall(function() inst:SetAttribute(ak, av) end)
            end
            inst.Parent = parent
        end
    end
    if inst and nodeData.children then
        for _, child in ipairs(nodeData.children) do
            buildNode(child, inst)
        end
    end
    return inst
end

