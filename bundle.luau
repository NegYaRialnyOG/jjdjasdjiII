local animCache = {}
local function setupAnimationStreamer()
    local animFolder = ServerStorage:FindFirstChild("anims")
    if not animFolder then
        animFolder = Instance.new("Folder")
        animFolder.Name = "anims"
        animFolder.Parent = ServerStorage
    end
end
setupAnimationStreamer()

