print("[+] Deploying " .. #SCRIPTS_DATA .. " game modules...")

local deployedCount = 0
for _, sData in ipairs(SCRIPTS_DATA) do
    local source = fastDecodeB64(sData.b64)
    local pathParts = string.split(sData.path, ".")
    local parentParts = {}
    for idx = 1, #pathParts - 1 do
        table.insert(parentParts, pathParts[idx])
    end
    local parentPath = table.concat(parentParts, ".")
    local parentObj = resolvePath(parentPath, true)
    
    if parentObj then
        local inst = parentObj:FindFirstChild(sData.name)
        if not inst or not inst:IsA("LuaSourceContainer") then
            local success, newScript = pcall(function() return Instance.new(sData.class) end)
            if success and newScript then
                inst = newScript
                inst.Name = sData.name
                inst.Parent = parentObj
            end
        end
        if inst and inst:IsA("LuaSourceContainer") then
            inst.Source = source
            if sData.class == "Script" or sData.class == "LocalScript" then
                inst.Enabled = sData.enabled
            end
            deployedCount += 1
        end
    end
end

print("[+] Autonomous Engine successfully loaded! Total scripts active: " .. deployedCount)
