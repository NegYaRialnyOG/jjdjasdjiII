local function decodeB64(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    data = string.gsub(data, '[^'..b..'=]', '')
    return (data:gsub('(.[\=]?)', function(x)
        if (#x == 0) then return '' end
        local r,f='',(b:find(x:sub(1,1))-1)
        local pad = 0
        if #x >= 2 and x:sub(2,2) ~= '=' then r=r..string.char(((f*4 + (b:find(x:sub(2,2))-1)/16)%256)) end
        if #x >= 3 and x:sub(3,3) ~= '=' then r=r..string.char((((b:find(x:sub(2,2))-1)*16 + (b:find(x:sub(3,3))-1)/4)%256)) end
        if #x >= 4 and x:sub(4,4) ~= '=' then r=r..string.char((((b:find(x:sub(3,3))-1)*64 + (b:find(x:sub(4,4))-1))%256)) end
        return r
    end))
end

-- Better base64 decoder using buffer if available in Luau
local function fastDecodeB64(str)
    local success, res = pcall(function()
        if buffer and buffer.frombase64 then
            local b = buffer.frombase64(str)
            return buffer.tostring(b)
        end
    end)
    if success and res then return res end
    return decodeB64(str)
end

local function deserializeValue(val)
    if type(val) ~= "table" then return val end
    local t = val.__type
    if not t then return val end
    if t == "Vector3" then return Vector3.new(val.x, val.y, val.z)
    elseif t == "Vector2" then return Vector2.new(val.x, val.y)
    elseif t == "Color3" then return Color3.new(val.r, val.g, val.b)
    elseif t == "CFrame" then return CFrame.new(table.unpack(val.c or val.components or {}))
    elseif t == "UDim2" then return UDim2.new(val.xs, val.xo, val.ys, val.yo)
    elseif t == "UDim" then return UDim.new(val.s, val.o)
    elseif t == "EnumItem" then
        local enumGroup = Enum[val.enum:gsub("Enum%.", "")]
        if enumGroup and enumGroup[val.name] then return enumGroup[val.name] end
    elseif t == "Font" then
        return Font.new(val.family, Enum.FontWeight[val.weight] or Enum.FontWeight.Regular, Enum.FontStyle[val.style] or Enum.FontStyle.Normal)
    elseif t == "NumberRange" then return NumberRange.new(val.min, val.max)
    end
    return nil
end

local function resolvePath(fullPath, createFolders)
    local parts = string.split(fullPath, ".")
    local curr = game
    for i = 1, #parts do
        local name = parts[i]
        local nextObj = curr:FindFirstChild(name)
        if not nextObj and createFolders then
            nextObj = Instance.new("Folder")
            nextObj.Name = name
            nextObj.Parent = curr
        end
        curr = nextObj
        if not curr then return nil end
    end
    return curr
end

